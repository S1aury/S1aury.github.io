---
import { local } from '../lib/paths';
import CoopLoop from './CoopLoop.astro';
interface Props { title: string; accent: string; coverImage?: string; coverAlt?: string; image?: string; imageAlt?: string; index?: number; compact?: boolean }
const { title, accent, image, imageAlt, coverImage, coverAlt, compact = false } = Astro.props;
const inventory = title === 'Hell or Sell';
const light = title === 'RatO.oLight';
---
<div class:list={['project-media', accent, { 'has-capture':Boolean(coverImage || image), 'has-custom-cover':Boolean(coverImage), 'cover-inventory': inventory, 'cover-light':light, compact }]}>
 {(coverImage || image) ? <img src={local(coverImage || image!)} alt={coverAlt || imageAlt || `${title} gameplay`} loading="lazy" width="1600" height="1000" /> : <CoopLoop/>}
 {!coverImage && (inventory || light) && <div class="cover-label"><span>{inventory ? 'SHAPE × SPACE' : 'LIGHT → OBJECT → PATH'}</span><small>{inventory ? 'Inventory detail · cropped gameplay' : 'Light, switches & routes · gameplay'}</small></div>}
</div>
