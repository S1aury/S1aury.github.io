---
import { local } from '../lib/paths';
interface Props { title: string; accent: string; image?: string; imageAlt?: string; index?: number }
const { title, accent, image, imageAlt, index = 1 } = Astro.props;
---
<div class:list={['project-media', accent]}>
  {image ? <img src={local(image)} alt={imageAlt || `${title} — gameplay screenshot`} loading="lazy" width="1440" height="900" /> :
    <div class="placeholder">
      <span class="media-top">PROJECT ARCHIVE <span>0{index}</span></span>
      <div class="abstract" aria-hidden="true"><i></i><i></i><i></i></div>
      <span class="media-bottom">GAMEPLAY CAPTURE <span>TODO · IMAGE PENDING</span></span>
      <span class="sr-only">Placeholder for {title}. Abstract decoration, not game footage.</span>
    </div>}
</div>
