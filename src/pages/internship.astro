---
import Layout from '../layouts/Layout.astro';
import AnnotatedCapture from '../components/AnnotatedCapture.astro';
import { internship } from '../data/profile';
import { local } from '../lib/paths';
const areas = [
 { id:0, title:'Bullet-dodging gameplay', activity:internship.activities[0], contribution:'I designed enemy movement, projectile patterns and player–enemy interactions for the released event.', label:'Design intent', decision:'Use movement and projectile patterns to invite different dodging responses.', marks:[{x:44,y:25,text:'Enemy waves and projectile patterns: the gameplay design area.'},{x:50,y:47,text:'Player movement and enemy interactions: the intended dodging experience.'}], note:'Released gameplay. These captures show the work area, not ownership of every element.' },
 { id:2, title:'TCG character card design', activity:internship.activities[2], contribution:'I designed skill effects, triggers, costs and values; configured cards in JSON and the card editor; and followed testing and balance work through release.', label:'Design decision', decision:'Internal testing exposed an underpowered character card. I adjusted its balance before release and checked implementation feasibility with programmers.', marks:[{x:49,y:68,text:'Character cards: skills, effects, triggers and costs interact during play.'},{x:49,y:91,text:'Cards and resource decisions belong to the wider match context.'}], note:'Public match shown for context. The pictured cards are not an attribution of my specific card work; internal values and tools are not shown.' },
 { id:1, title:'UGC & multiplayer content', activity:internship.activities[1], contribution:'I configured and validated lobby, party and menu flows, checked UI behavior against specifications, and communicated issues with QA and engineers.', label:'Validation criterion', decision:'Check how the flow behaves against its specification and follow discrepancies through fixes and validation.', marks:[{x:59,y:15,text:'Search and navigation: public examples of the menu context.'},{x:44,y:40,text:'Stage categories and content browsing: part of the wider UGC experience.'}], note:'Public browser shown for context. My contribution was configuration, review and validation, not independent ownership of the UGC system.' }
];
---
<Layout title="miHoYo Internship — Beiming Xu" description="My gameplay, TCG and UGC contributions to Genshin Impact.">
<header class="wrap internship-page-header"><a class="text-link" href={local()+'#internship'}>← Portfolio</a><p class="eyebrow">INDUSTRY EXPERIENCE</p><h1>Genshin Impact</h1><p>miHoYo · {internship.role}</p><p>{internship.dates} · {internship.location}</p><nav class="resource-links" aria-label="Internship areas">{areas.map(a=><a class="text-link" href={`#area-${a.id}`}>{a.title} ↓</a>)}</nav></header>
<section class="wrap internship-showcase">{areas.map((area,i)=><article id={`area-${area.id}`} class="internship-area">
<div class="internship-copy"><p class="eyebrow">0{i+1} / {area.title}</p><h2>{area.title}</h2><p class="label">MY RESPONSIBILITY</p><p>{area.contribution}</p><div class="judgment"><p class="label">{area.label}</p><p>{area.decision}</p></div></div>
<div class="internship-visual"><AnnotatedCapture src={area.activity.images[0].src} alt={area.activity.images[0].alt} caption="Public product context · portfolio annotations" marks={area.id===1?[]:area.marks}/><p class="label scope-label">RESULT & SCOPE</p><p class="evidence-note">{area.id===0?"Design work implemented in the released event. ":area.id===2?"Character-card work followed through release. ":"Configuration, review and validation completed within the described scope. "}{area.note}</p>{area.id===0 && <figure><a href={local(area.activity.images[1].src)}><img src={local(area.activity.images[1].src)} alt={area.activity.images[1].alt} loading="lazy"/></a><figcaption>Projectile spacing and available movement space are read together. This is released product context; individual elements are not separately attributed.</figcaption></figure>}</div>
</article>)}</section>
<div class="wrap internship-note"><p>Genshin Impact is a team production. Only the responsibilities described here are attributed to me. Public images belong to their respective rights holders. No internal documents, card identities or numerical values are disclosed.</p><a class="text-link" href={local()+'#work'}>Explore personal projects ↗</a></div>
</Layout>
