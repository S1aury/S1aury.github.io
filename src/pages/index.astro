---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { profile, internship } from '../data/profile';
import { local } from '../lib/paths';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);

---
<Layout>
 <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-top"><div><p class="hero-name">BEIMING XU</p><p class="hero-portfolio">GAME DESIGN PORTFOLIO</p></div><span class="location">University of California, Irvine</span></div>
    <h1 id="hero-title">Systems &amp; Gameplay<br />Designer<span class="orange">.</span></h1>
    <div class="hero-bottom"><div><p class="hero-role">Systems. Levels. Player experience.</p><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button" href="#work">View projects <span aria-hidden="true">↓</span></a>{profile.resume ? <a class="text-link" href={local(profile.resume)}>Resume ↗</a> : <span class="pending">Resume · TODO</span>}<a class="text-link" href="#contact">Contact ↗</a></div></div>
    <div class="hero-index"><span>01 — Systems & gameplay</span><span>02 — Levels & player learning</span><span>03 — Game direction</span></div></div>
    <div class="hero-caption"><span>RULES. DECISIONS. PLAYABLE EXPERIENCES.</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
 <section id="internship" class="wrap internship-home" aria-label="Internship summary"><div class="internship-summary"><img src={local('images/internship/mihoyo-logo.webp')} alt="miHoYo" width="889" height="415"/><div><p class="eyebrow">GENSHIN IMPACT</p><h2>Game Design Intern</h2><p>{internship.dates}</p><p>Bullet-dodging gameplay · TCG card design · UGC & multiplayer</p></div></div><div class="internship-peeks"><article><a class="internship-picture" href={local('internship/#area-2')} aria-label="View TCG card design details"><img src={local('images/internship/gcg-match.webp')} alt="Public Genius Invokation TCG match" loading="lazy"/></a><div><p class="eyebrow">GENSHIN IMPACT</p><h3>TCG · Card design</h3></div><div class="internship-detail-action"><a class="text-link" href={local('internship/#area-2')}>View TCG contributions & details ↗</a></div></article><article><a class="internship-picture" href={local('internship/#area-0')} aria-label="View released bullet-dodging gameplay details"><img src={local('images/internship/live-event-waves.webp')} alt="Released Genshin Impact bullet-dodging encounter" loading="lazy"/></a><div><p class="eyebrow">GENSHIN IMPACT</p><h3>Released 2D Bullet-Dodging Gameplay</h3></div><div class="internship-detail-action"><a class="text-link" href={local('internship/#area-0')}>View gameplay contributions & details ↗</a></div></article><p class="evidence-note">Public product context · Genshin Impact imagery belongs to its respective rights holders. Only the contributions described in the detail page are attributed to me.</p><a class="text-link internship-all-details" href={local('internship/')}>View full internship experience ↗</a></div></section>
 <section id="work" class="wrap section" aria-labelledby="work-title">
  <div class="section-heading"><div><p class="eyebrow">PERSONAL PROJECT</p><h2 id="work-title">Personal Project</h2></div><p>My contribution, the choices behind it, and what the team delivered.</p></div>
  <div class="main-projects">{projects.filter(p=>p.data.tier==='main').map(p=><ProjectCard project={p} index={projects.indexOf(p)}/>)}</div>
  <div class="supporting-heading"><h3>Smaller projects, focused ideas</h3><span>Mechanics / economy / rapid prototyping</span></div>
  <div class="supporting-projects">{projects.filter(p=>p.data.tier==='supporting').map(p=><ProjectCard project={p} index={projects.indexOf(p)}/>)}</div>
 </section>
 <section id="process" class="wrap section compact-section" aria-labelledby="process-title"><div class="section-heading"><div><p class="eyebrow">DESIGN IN PRACTICE</p><h2 id="process-title">Design in practice</h2></div></div><div class="decision-links"><a href={local('projects/hell-or-sell/#decision')}><img src={local("images/hell-or-sell/practice.png")} alt="Hell or Sell inventory and selling phase" loading="lazy"/><span>SYSTEMS / HELL OR SELL</span><h3>Less effect complexity.<br/>More spatial choices.</h3><p>Why I moved variation into inventory shapes and level constraints.</p><b>See the decision & concept diagram ↗</b></a><a href={local('projects/ratoolight/#decision')}><img src={local("images/ratoolight/practice.png")} alt="RatO.oLight released laboratory puzzle with colored light and objects" loading="lazy"/><span>LEVELS / RATO.OLIGHT</span><h3>From precision jumping<br/>to discovering rules.</h3><p>How a new role for light gave the project a clearer direction.</p><b>See the prototype & released direction ↗</b></a></div></section>
 <span id="production"></span>
 <section id="experience" class="wrap overview-menu" aria-label="Portfolio overview"><p class="eyebrow">EXPLORE THE PORTFOLIO</p><nav aria-label="Portfolio overview"><div class="overview-row"><span>01 / INTERNSHIP</span><a href="#internship">miHoYo · Genshin Impact <b>↓</b></a></div><div class="overview-row"><span>02 / PERSONAL PROJECT</span><div class="overview-projects">{projects.map(p=><a href={local(`projects/${p.id}/`)}>{p.data.title} <b>↗</b></a>)}</div></div><div class="overview-row"><span>03 / DESIGN & ABOUT</span><div class="overview-projects"><a href="#process">Design in practice <b>↓</b></a><a href="#contact">About · UC Irvine · Contact <b>↓</b></a><a href={local(profile.resume)}>Resume <b>↗</b></a></div></div></nav></section>
 <section id="contact" class="contact-section section" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><p class="eyebrow">ABOUT / CONTACT</p><h2 id="contact-title">I find joy in making games.</h2></div><div><p class="about-copy">{profile.about}</p><p>I believe games can bring people joy, make them laugh, and offer something to learn from or reflect on. I want to grow as a systems designer and Game Director, creating experiences worth sharing.</p><div class="about-education"><h3>University of California, Irvine</h3><p>B.S. Game Design and Interactive Media<br/>{profile.educationDates}</p></div><div class="contact-links"><a href={`mailto:${profile.email}`}>Email ↗</a><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a><a href={local(profile.resume)}>Resume PDF ↗</a></div></div></div></section>
</Layout>
