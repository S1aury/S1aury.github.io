---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { profile, otherProjects, otherProjectDetails, internship } from '../data/profile';
import { local } from '../lib/paths';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
const steps = ['Problem','Analysis','Design','Prototype','Playtest','Iteration'];
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-top"><p class="eyebrow">PORTFOLIO / GAME DESIGN</p><span class="location">University of California, Irvine</span></div>
    <h1 id="hero-title">BEIMING XU<span class="orange">.</span></h1>
    <div class="hero-bottom"><div><p class="hero-role">Game Designer <span>| Producer</span></p><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button" href="#work">View projects <span aria-hidden="true">↓</span></a>{profile.resume ? <a class="text-link" href={local(profile.resume)}>Resume ↗</a> : <span class="pending">Resume · TODO</span>}<a class="text-link" href="#contact">Contact ↗</a></div></div>
    <div class="hero-index"><span>01 — Systems & economy</span><span>02 — Puzzles & levels</span><span>03 — Team production</span></div></div>
    <div class="hero-caption"><span>RULES. DECISIONS. PLAYABLE EXPERIENCES.</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
  <section id="internship" class="internship-section section" aria-labelledby="internship-title"><div class="wrap">
    <div class="section-heading"><p class="eyebrow">01 / INDUSTRY EXPERIENCE</p><h2 id="internship-title">Internship</h2><p>Activities and responsibilities from my game systems design internship.</p></div>
    <div class="internship-heading"><img class="internship-logo" src={local('images/internship/mihoyo-logo.webp')} alt="MiHoyo — Tech Otakus Save the World" width="889" height="415" /><div class="internship-identity"><h3>{internship.company}</h3><p class="internship-role">{internship.role}</p><p class="internship-project">Project · {internship.project}</p><p class="internship-project">{internship.location}</p></div><p class="pending">{internship.dates || 'Dates · TODO'}</p></div>
    <div class="internship-details">
      <div><p class="eyebrow">MY RESPONSIBILITIES</p>{internship.responsibilities.length ? <ul>{internship.responsibilities.map(item => <li>{item}</li>)}</ul> : <p class="pending">TODO · Specific responsibilities and individual contributions to be added.</p>}</div>
      <div><p class="eyebrow">DESIGN & COLLABORATION</p><p class="internship-summary">{internship.summary}</p></div>
    </div>
    <div class="internship-showcase">
      {internship.activities.map((activity, i) => <article class="internship-gallery" aria-labelledby={`internship-area-${i}`}>
        <div class="internship-gallery-heading"><p class="eyebrow">0{i + 1} / PUBLIC GAMEPLAY</p><h3 id={`internship-area-${i}`}>{activity.title}</h3><p>{activity.summary}</p></div>
        <div class:list={['internship-captures', { paired: activity.images.length > 1 }]}>{activity.images.map(img => <figure><a href={local(img.src)} aria-label={`View full-size image: ${img.caption}`}><img src={local(img.src)} alt={img.alt} loading="lazy" /></a><figcaption>{img.caption}</figcaption></figure>)}</div>
      </article>)}
    </div>
    <p class="internship-note">Public Genshin Impact gameplay screenshots provide context for the work areas above. Individual responsibilities are described separately. Game imagery belongs to its respective rights holders.</p>
  </div></section>
  <section id="work" class="wrap section" aria-labelledby="work-title">
    <div class="section-heading"><p class="eyebrow">02 / SELECTED WORK</p><h2 id="work-title">Designed to be played.<br /><span class="muted">Built to be understood.</span></h2><p>Systems, choices, and the work behind them.</p></div>
    <p class="content-note">Archive in progress. Gameplay images and supporting case study evidence are marked TODO where not yet provided.</p>
    {projects.map((project,index) => <ProjectCard project={project} index={index} />)}
    <div class="other-projects"><p class="eyebrow">ALSO IN THE ARCHIVE</p>{otherProjects.map(p => <div><div><h3>{p}</h3>{otherProjectDetails[p] && <><p class="other-project-description">{otherProjectDetails[p].summary}</p><p class="pending">{otherProjectDetails[p].role}</p></>}</div><span>{otherProjectDetails[p]?.status || 'Details pending · TODO'}</span></div>)}</div>
  </section>
  <section id="process" class="process-section section" aria-labelledby="process-title"><div class="wrap">
    <div class="section-heading"><p class="eyebrow">03 / DESIGN THINKING</p><h2 id="process-title">Start with a question.<br /><span class="muted">Make the answer playable.</span></h2><p>A framework for documenting design work, rather than a claim that every project has completed every stage.</p></div>
    <ol class="process-line">{steps.map((step,i) => <li><span>0{i+1}</span>{step}<b aria-hidden="true">↗</b></li>)}</ol>
    <div class="process-examples"><div><p class="eyebrow">SYSTEMS / HELL OR SELL</p><h3>Reuse systems. Change the decisions.</h3><p>The current build separates item placement from selling. A planned refactor reuses item shapes and combinations for timed combo clearing, shifting the focus from slow planning to quick decisions.</p><p class="pending">Current build documented · Refactor and its player impact remain unverified.</p><a class="text-link" href={local('projects/hell-or-sell/')}>Explore the system scope ↗</a></div><div><p class="eyebrow">LEVELS / RATO.OLIGHT</p><h3>Make the rules readable.</h3><p>RatO.oLight uses light-dependent object behavior and knowledge-gated exploration. My level work focused on how players encounter and apply those rules.</p><p class="pending">TODO · Annotated level sequence and specific iteration evidence.</p><a class="text-link" href={local('projects/ratoolight/')}>Explore the puzzle scope ↗</a></div></div>
  </div></section>
  <section id="production" class="wrap section" aria-labelledby="production-title"><div class="section-heading"><p class="eyebrow">04 / PRODUCTION & LEADERSHIP</p><h2 id="production-title">From design intent<br /><span class="muted">to a shared plan.</span></h2><p>Alongside design, I take on Lead Designer, Producer, and Project Manager responsibilities in student and personal projects.</p></div>
    <div class="production-grid"><div class="production-feature"><p class="eyebrow">PROJECT CONTEXT / RATO.OLIGHT</p><h3>Designing puzzles.<br />Coordinating people.</h3><p>As Lead Designer / Project Manager, I worked on level and puzzle design and coordinated members across disciplines.</p><a class="text-link" href={local('projects/ratoolight/')}>View project context ↗</a></div><div class="production-list">{[['01','Scope & priorities','Hell or Sell: when complex features exceeded implementation capacity, I adjusted scope and direction. The next design proposal reuses existing systems to explore a different pace of play.'],['02','Cross-disciplinary coordination','RatO.oLight: I coordinate design, programming, art, and audio work alongside level and puzzle design. A specific handoff example will be added.'],['03','Documentation & risk','Hell or Sell: my design work includes system diagrams and rules for the core loop and progression. These help communicate the intended design; approved excerpts are pending.']].map(([n,t,d])=><div><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></div>)}</div></div>
  </section>
  <section id="experience" class="wrap section" aria-labelledby="experience-title"><div class="section-heading compact"><p class="eyebrow">05 / EXPERIENCE</p><h2 id="experience-title">A foundation in design.</h2></div>
    <div class="experience-row"><span>INTERNSHIP</span><div><h3>{internship.company} · {internship.project}</h3><p>{internship.role}</p><p class="pending">{internship.dates}</p></div><a class="text-link" href="#internship">Internship details ↗</a></div>
    <div class="experience-row"><span>EDUCATION</span><div><h3>University of California, Irvine</h3><p>B.S. Game Design and Interactive Media</p></div><span class="pending">{profile.educationDates}</span></div>
    {projects.map(project => <div class="experience-row"><span>TEAM PROJECT</span><div><h3>{project.data.title}</h3><p>{project.data.role}</p><p class="pending">{project.data.year}</p></div><a class="text-link" href={local(`projects/${project.id}/`)}>Case study ↗</a></div>)}
  </section>
  <section id="contact" class="contact-section section" aria-labelledby="contact-title"><div class="wrap"><p class="eyebrow">06 / ABOUT & CONTACT</p><div class="contact-grid"><div><h2 id="contact-title">Good games begin<br />with meaningful<br /><em>decisions.</em></h2></div><div><p class="about-copy">{profile.about}</p><p>I build gameplay and progression systems, plan how players learn mechanics, and translate design goals into documentation, implementation rules, and team tasks.</p><div class="contact-links">{profile.email ? <a href={`mailto:${profile.email}`}>Email ↗</a> : <span>Email <small>TODO · address pending</small></span>}{profile.linkedin ? <a href={profile.linkedin}>LinkedIn ↗</a> : <span>LinkedIn <small>TODO · link pending</small></span>}<a href={profile.github}>GitHub ↗</a>{profile.resume ? <a href={local(profile.resume)}>Resume PDF ↗</a> : <span>Resume PDF <small>TODO · file pending</small></span>}</div></div></div></div></section>
</Layout>

<style>
  .internship-section { background: #eceae1; }
  .internship-heading { display: flex; align-items: start; justify-content: space-between; gap: 24px; padding: 28px 0; border-block: 1px solid var(--line); }
  .internship-logo { width: 220px; max-width: 100%; height: auto; flex-shrink: 0; }
  .internship-identity { flex: 1; }
  .internship-heading h3 { font-size: clamp(32px, 3.6vw, 48px); margin-bottom: 12px; }
  .internship-role { color: var(--orange); font-size: 15px; margin: 0; }
  .internship-project { color: var(--muted); font-size: 14px; margin: 10px 0 0; }
  .internship-details { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; padding-block: 34px; }
  .internship-details .eyebrow { color: var(--muted); margin-bottom: 18px; }
  .internship-details ul { padding-left: 18px; margin: 0; font-size: 15px; line-height: 1.8; }
  .internship-details .pending { max-width: 420px; font-size: 14px; }
  .internship-showcase { margin-top: 30px; }
  .internship-gallery { border-top: 1px solid var(--line); padding: 34px 0; }
  .internship-gallery-heading h3 { font-size: clamp(25px, 3vw, 36px); margin: 12px 0; }
  .internship-gallery-heading > p:last-child { max-width: 720px; font-size: 15px; color: var(--muted); margin-bottom: 24px; }
  .internship-captures { width: calc((100% - 24px) / 2); }
  .internship-captures.paired { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .internship-captures figure { margin: 0; min-width: 0; }
  .internship-captures a { display: block; }
  .internship-captures img { width: 100%; height: auto; display: block; }
  .internship-captures figcaption { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .internship-activity + .internship-activity { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); }
  .internship-activity h4 { font-size: 22px; font-weight: 500; letter-spacing: -.025em; margin: 0 0 16px; }
  .internship-activity p { font-size: 15px; }
  .internship-summary { font-size: 15px; line-height: 1.8; margin: 0; }
  .other-project-description { font-size: 14px; color: var(--muted); max-width: 660px; margin: 12px 0; }
  .other-projects > div > span { max-width: 250px; flex-shrink: 0; line-height: 1.6; }
  .experience-row > span:last-child { max-width: 190px; }
  .internship-note { color: var(--muted); font-size: 12px; border-top: 1px solid var(--line); padding-top: 20px; margin: 0; }
  @media(max-width: 700px) {
    .internship-captures { width: 100%; }
    .internship-captures.paired { grid-template-columns: 1fr; }
    .internship-logo { width: 180px; }
    .internship-heading { flex-direction: column; gap: 14px; }
    .internship-heading > .pending { margin: 0; }
    .internship-details { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
